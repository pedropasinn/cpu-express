+    harness.publish(ready(37.0));
+    let recovered = harness.worker().poll().unwrap();
+    assert_eq!(recovered.status, MetricStatus::Ready);
+    assert_eq!(recovered.cpu_percent, Some(37.0));
+    assert_eq!(recovered.memory_bytes(), Some((250, 1_000)));
+}
+
+#[test]
