+#!/usr/bin/env python3
+"""Summarize an opt-in Windows measurement, after the measured process exits.
+
+Only Python's standard library is used. CSV/JSONL samples are measurements, not
+instructions. No target process is started and no artificial CPU load is made.
+"""
+
+from __future__ import annotations
+
+import argparse
+import csv
+import json
+import math
+from pathlib import Path
+from typing import Any
+
+
+def number(value: Any, label: str) -> float:
+    """Read finite numbers; accept decimal-comma CSV produced on some locales."""
+    if isinstance(value, bool) or value is None:
+        raise ValueError(f"{label}: expected a finite number")
+    if isinstance(value, str) and "," in value and "." not in value:
+        value = value.replace(",", ".")
+    try:
+        result = float(value)
+    except (ValueError, TypeError, OverflowError) as error:
+        raise ValueError(f"{label}: expected a finite number") from error
+    if not math.isfinite(result):
+        raise ValueError(f"{label}: NaN/infinity is not a measurement")
+    return result
+
+
+def nonnegative(value: Any, label: str) -> float:
+    result = number(value, label)
+    if result < 0:
+        raise ValueError(f"{label}: negative counter")
+    return result
+
+
+def counter(value: Any, label: str) -> int:
+    result = nonnegative(value, label)
+    if not result.is_integer():
+        raise ValueError(f"{label}: expected an integer counter")
+    return int(result)
+
+
+def distribution(values: list[float], unit: str) -> dict[str, Any]:
+    """P50/P95 use linear interpolation at index (n - 1) * p (type 7)."""
+    ordered = sorted(values)
+
+    def quantile(p: float) -> float | None:
+        if not ordered:
+            return None
+        position = (len(ordered) - 1) * p
+        lower = math.floor(position)
+        upper = math.ceil(position)
+        return ordered[lower] + (ordered[upper] - ordered[lower]) * (position - lower)
+
+    return {
+        "unit": unit,
+        "samples": len(values),
+        "minimum": ordered[0] if ordered else None,
+        "p50": quantile(0.5),
+        "p95": quantile(0.95),
+        "maximum": ordered[-1] if ordered else None,
+        "arithmetic_mean": math.fsum(values) / len(values) if values else None,
+    }
+
+
+def analyze_process(
+    rows: list[dict[str, Any]], logical_processors: int | None, warmup_seconds: float
+) -> dict[str, Any]:
+    """Recompute CPU from time counters, never from rounded percentage columns."""
+    if logical_processors is not None:
+        logical_processors = counter(logical_processors, "logical_processors")
+        if logical_processors == 0:
+            raise ValueError("logical_processors must be positive")
+    warmup_seconds = nonnegative(warmup_seconds, "warmup_seconds")
+    parsed: list[dict[str, float]] = []
+    previous: dict[str, float] | None = None
+    for index, row in enumerate(rows, 2):
+        label = f"CSV line {index}"
+        current = {
+            key: nonnegative(row.get(key), f"{label}: {key}")
+            for key in (
+                "elapsed_seconds", "interval_seconds", "process_cpu_seconds",
+                "interval_cpu_seconds", "working_set_bytes", "private_memory_bytes",
+            )
+        }
+        duration = current["interval_seconds"]
+        start = current["elapsed_seconds"] - duration
+        if duration == 0 or start < -1e-8:
+            raise ValueError(f"{label}: invalid measurement interval")
+        if current["interval_cpu_seconds"] > current["process_cpu_seconds"] + 1e-8:
+            raise ValueError(f"{label}: interval CPU exceeds lifetime CPU counter")
+        if previous is not None:
+            if start < previous["elapsed_seconds"] - 1e-6:
+                raise ValueError(f"{label}: overlapping or non-monotonic intervals")
+            delta = current["process_cpu_seconds"] - previous["process_cpu_seconds"]
+            if delta < 0:
+                raise ValueError(f"{label}: CPU counter reset; do not join different runs")
+            if not math.isclose(delta, current["interval_cpu_seconds"], rel_tol=1e-7, abs_tol=1e-7):
+                raise ValueError(f"{label}: interval CPU disagrees with cumulative CPU")
+        current["start_seconds"] = max(0.0, start)
+        current["cpu_percent_one_logical_processor"] = (
+            100.0 * current["interval_cpu_seconds"] / duration
+        )
+        if logical_processors is not None:
+            current["cpu_percent_machine"] = (
+                current["cpu_percent_one_logical_processor"] / logical_processors
+            )
+        parsed.append(current)
+        previous = current
+
+    # An interval crossing warmup is excluded as a whole; no invented prorating.
+    steady = [row for row in parsed if row["start_seconds"] >= warmup_seconds]
+    duration = math.fsum(row["interval_seconds"] for row in steady)
+    cpu_seconds = math.fsum(row["interval_cpu_seconds"] for row in steady)
+    span = (
+        steady[-1]["elapsed_seconds"] - steady[0]["start_seconds"] if steady else 0.0
+    )
+    result = {
+        "logical_processors_denominator": logical_processors,
+        "machine_cpu_normalization_available": logical_processors is not None,
+        "samples_total": len(parsed),
+        "samples_after_warmup": len(steady),
+        "first_interval_start_seconds": steady[0]["start_seconds"] if steady else None,
+        "last_interval_end_seconds": steady[-1]["elapsed_seconds"] if steady else None,
+        "observed_wall_seconds_after_warmup": duration,
+        "unobserved_gap_seconds_after_warmup": max(0.0, span - duration),
+        "cpu_seconds_after_warmup": cpu_seconds if steady else None,
+        "cpu_seconds_over_all_observed_intervals": (
+            math.fsum(row["interval_cpu_seconds"] for row in parsed) if parsed else None
+        ),
+        "process_cpu_seconds_at_last_observation": (
+            parsed[-1]["process_cpu_seconds"] if parsed else None
+        ),
+        "lifetime_cpu_total_complete": False,
+        "cpu_percent_one_logical_processor_weighted_mean": (
+            100.0 * cpu_seconds / duration if duration else None
+        ),
+        "cpu_percent_machine_weighted_mean": (
+            100.0 * cpu_seconds / duration / logical_processors
+            if duration and logical_processors is not None else None
+        ),
+    }
+    for key, unit in (
+        ("cpu_percent_one_logical_processor", "% of one logical processor"),
+        ("cpu_percent_machine", "% of total logical processor count"),
+        ("working_set_bytes", "bytes (resident shared + private pages)"),
+        ("private_memory_bytes", "bytes (private committed memory)"),
+        ("interval_seconds", "seconds"),
+    ):
+        result[key] = distribution([row[key] for row in steady if key in row], unit)
+    return result
+
+
+def frame_intervals_summary(intervals: list[dict[str, Any]]) -> dict[str, Any]:
+    duration = math.fsum(interval["seconds"] for interval in intervals)
+    frames = sum(interval["frames"] for interval in intervals)
+    return {
+        "intervals": len(intervals),
+        "observed_seconds": duration,
+        "rendered_frames": frames if intervals else None,
+        "fps_weighted_mean": frames / duration if duration else None,
+        "fps": distribution([interval["fps"] for interval in intervals], "rendered frames/s"),
+        "interval_seconds": distribution([interval["seconds"] for interval in intervals], "seconds"),
+    }
+
+
+def analyze_frames(rows: list[dict[str, Any]], warmup_seconds: float) -> dict[str, Any]:
+    warmup_seconds = nonnegative(warmup_seconds, "warmup_seconds")
+    groups: dict[str, list[dict[str, Any]]] = {
+        "all": [], "visible_at_both_endpoints": [], "hidden_at_both_endpoints": [],
+        "transition_or_unknown": [],
+    }
+    previous: dict[str, Any] | None = None
+    duplicate_records = 0
+    statuses: dict[str, int] = {}
+    stale_records = 0
+    for index, row in enumerate(rows, 1):
+        label = f"JSONL line {index}"
+        current = {
+            "seconds": nonnegative(row.get("elapsed_seconds"), f"{label}: elapsed_seconds"),
+            "frames": counter(row.get("rendered_frames"), f"{label}: rendered_frames"),
+            "hidden": row.get("hidden"),
+        }
+        if current["hidden"] is not None and not isinstance(current["hidden"], bool):
+            raise ValueError(f"{label}: hidden must be true, false, or null")
+        if current["seconds"] >= warmup_seconds:
+            status = str(row.get("metric_status", "unknown"))
+            statuses[status] = statuses.get(status, 0) + 1
+            stale_records += row.get("metrics_stale") is True
+        if previous is not None:
+            elapsed = current["seconds"] - previous["seconds"]
+            frames = current["frames"] - previous["frames"]
+            if elapsed < 0 or frames < 0:
+                raise ValueError(f"{label}: non-monotonic diagnostic counters")
+            if elapsed == 0:
+                if frames:
+                    raise ValueError(f"{label}: frame advance without elapsed time")
+                duplicate_records += 1
+            elif previous["seconds"] >= warmup_seconds:
+                interval = {"seconds": elapsed, "frames": frames, "fps": frames / elapsed}
+                groups["all"].append(interval)
+                if previous["hidden"] is True and current["hidden"] is True:
+                    category = "hidden_at_both_endpoints"
+                elif previous["hidden"] is False and current["hidden"] is False:
+                    category = "visible_at_both_endpoints"
+                else:
+                    category = "transition_or_unknown"
+                groups[category].append(interval)
+        previous = current
+
+    return {
+        "available": True,
+        "records": len(rows),
+        "duplicate_time_records": duplicate_records,
+        "shutdown_record_seen": any(row.get("event") == "shutdown" for row in rows),
+        "rendered_frames_at_last_observation": previous["frames"] if previous else None,
+        "recorded_metric_status_counts_after_warmup": statuses,
+        "records_marked_stale_after_warmup": stale_records,
+        "groups": {key: frame_intervals_summary(value) for key, value in groups.items()},
+        "guaranteed_frames_while_hidden": None,
+        "visibility_evidence": "app-reported visibility at interval endpoints only",
+        "scope": "Scene rasterizations counted by app.rs; not display presents or GPU frame times",
+        "caveat": (
+            "Equal endpoint states do not prove continuous visibility between records. "
+            "Transitions/unknown states are separate; null is not zero. "
+            "The baseline hidden flag does not independently verify native minimization."
+        ),
+    }
+
+
+def reject_json_constant(value: str) -> None:
+    raise ValueError(f"Non-standard JSON numeric value: {value}")
+
+
+def read_json(path: Path) -> dict[str, Any]:
+    result = json.loads(path.read_text(encoding="utf-8-sig"), parse_constant=reject_json_constant)
+    if not isinstance(result, dict):
+        raise ValueError(f"{path.name}: expected an object")
+    return result
+
+
+def analyze_run(directory: Path) -> dict[str, Any]:
+    baseline = read_json(directory / "summary.json")
+    with (directory / "process-samples.csv").open(encoding="utf-8-sig", newline="") as source:
+        process_rows = list(csv.DictReader(source))
+    machine = baseline.get("machine") or {}
+    warmup = nonnegative(baseline.get("warmup_seconds"), "warmup_seconds")
+    process = analyze_process(process_rows, machine.get("logical_processors"), warmup)
+    diagnostics = directory / "application.jsonl"
+    warnings = list(baseline.get("metadata_warnings") or [])
+    if diagnostics.is_file():
+        frame_rows = []
+        for line_no, line in enumerate(diagnostics.read_text(encoding="utf-8-sig").splitlines(), 1):
+            if line.strip():
+                value = json.loads(line, parse_constant=reject_json_constant)
+                if not isinstance(value, dict):
+                    raise ValueError(f"JSONL line {line_no}: expected an object")
+                frame_rows.append(value)
+        frames = analyze_frames(frame_rows, warmup)
+        if not frames["shutdown_record_seen"]:
+            warnings.append("No shutdown diagnostic record; the last frame interval may be missing.")
+    else:
+        frames = {
+            "available": False, "fps": None, "guaranteed_frames_while_hidden": None,
+            "reason": "No application.jsonl. Repeat with -IncludeDiagnostics to measure render counters.",
+        }
+    if baseline.get("diagnostics_enabled") is True and not diagnostics.is_file():
+        warnings.append("Diagnostics requested but missing; no FPS or hidden-frame measurement available.")
+    if process["samples_after_warmup"] == 0:
+        warnings.append("No complete CPU intervals after warmup; empty distributions are not zero usage.")
+    if not process["machine_cpu_normalization_available"]:
+        warnings.append("Logical processor count is unknown; normalized machine CPU is unavailable.")
+    metadata_path = directory / "benchmark-metadata.json"
+    metadata = read_json(metadata_path) if metadata_path.is_file() else None
+    if metadata is None:
+        warnings.append("No wrapper metadata: driver, power source and requested window state are unknown.")
+    else:
+        warnings.extend(metadata.get("metadata_warnings") or [])
+        if metadata.get("power_scheme_changed") is True:
+            warnings.append("Power scheme changed during measurement; do not treat the run as a fixed-energy-condition trial.")
+    complete = (
+        baseline.get("error") is None and baseline.get("exit_code") == 0
+        and baseline.get("forced_stop") is False
+    )
+    if not complete:
+        warnings.append("Source measurement was incomplete or unsuccessful; statistics describe partial observations.")
+    return {
+        "schema_version": 1,
+        "source_run_directory": str(directory.resolve()),
+        "source_run_completed": complete,
+        "requested_seconds": baseline.get("requested_seconds"),
+        "actual_wall_seconds": baseline.get("actual_wall_seconds"),
+        "warmup_seconds": warmup,
+        "quantile_method": "type 7, linear interpolation at (n - 1) * p; unweighted interval samples",
+        "executable": baseline.get("executable"),
+        "machine": machine,
+        "configuration": baseline.get("configuration"),
+        "benchmark_metadata": metadata,
+        "process": process,
+        "render": frames,
+        "warnings": warnings,
+        "interpretation": [
+            "CPU 100% on the one-logical-processor scale means one logical processor occupied; it can exceed 100%.",
+            "Machine CPU divides that rate by the recorded logical processor count, not by physical cores.",
+            "CPU rates are process CPU-time deltas divided by actual observation intervals; weighted means use totals.",
+            "The last sampled lifetime CPU counter omits work after the final poll; it is not a complete lifetime total.",
+            "Working set includes shared pages; private committed bytes are not another physical-RAM measure.",
+            "FPS is computed from rendered-frame deltas, not configured FPS; P95 FPS is not P95 frame latency.",
+            "Endpoint visibility samples cannot prove an exact count of frames rendered while continuously hidden.",
+            "Old Linux/Mesa runs from different projects are not a controlled A/B comparison with this run.",
+        ],
+    }
+
+
+def main() -> int:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("run_directory", type=Path, help="Directory containing summary.json and process-samples.csv")
+    parser.add_argument("--output", type=Path, help="Default: RUN_DIRECTORY/analysis.json")
+    args = parser.parse_args()
+    try:
+        result = analyze_run(args.run_directory)
+        output = args.output or args.run_directory / "analysis.json"
+        output.write_text(json.dumps(result, indent=2, ensure_ascii=False, allow_nan=False) + "\n", encoding="utf-8")
+    except (OSError, ValueError, TypeError) as error:
+        parser.exit(2, f"Measurement analysis failed: {error}\n")
+    print(f"Saved: {output}")
+    print(f"Post-warmup process samples: {result['process']['samples_after_warmup']}; warnings: {len(result['warnings'])}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
