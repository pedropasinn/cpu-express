+    active_power_scheme_before = (Get-ActivePowerPlan)
+    active_power_scheme_after = $null
+    power_scheme_changed = $null
+    display_note = $DisplayNote
+    operator_notes = $Notes
+    diagnostics_requested = [bool]$IncludeDiagnostics
+    measurement_completed = $false
+    measurement_error = $null
+    metadata_warnings = @($metadataWarnings.ToArray())
+}
+$metadataFile = Join-Path $contextDirectory 'benchmark-metadata.json'
+[IO.File]::WriteAllText($metadataFile, ($metadata | ConvertTo-Json -Depth 8), $utf8NoBom)
+
+Write-Host "Scenario declared: $Scenario. Context: $contextDirectory"
+if ($Scenario -eq 'minimized') {
