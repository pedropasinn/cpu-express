+    def test_missing_observations_are_not_zero_cpu(self):
+        result = analyze_process([], 8, 15)
+        self.assertEqual(result["samples_after_warmup"], 0)
+        self.assertIsNone(result["cpu_percent_machine"]["p50"])
+        self.assertIsNone(result["cpu_seconds_after_warmup"])
+        self.assertIsNone(result["process_cpu_seconds_at_last_observation"])
+
+    def test_decimal_comma_and_bom_are_supported(self):
+        row = process_row("1,25", "1,25", "0,125", "0,125")
