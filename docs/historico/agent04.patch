+        manufacturer = $system.Manufacturer; model = $system.Model
+        total_physical_memory_bytes = $physicalMemory
+    }
+} catch {
+    $metadataWarnings.Add('Computer metadata unavailable: ' + $_.Exception.Message)
+}
+try {
+    # Do not invoke rustc/rustup: a proxy might download a missing toolchain.
+    # Record the compiler from the operator's build log instead.
+    $lockPath = Join-Path $repositoryRoot 'Cargo.lock'
+    if (Test-Path -LiteralPath $lockPath -PathType Leaf) {
+        $lockSha256 = (Get-FileHash -LiteralPath $lockPath -Algorithm SHA256).Hash.ToLowerInvariant()
+    }
+} catch {
+    $metadataWarnings.Add('Some build context unavailable: ' + $_.Exception.Message)
+}
+$metadata = [ordered]@{
+    schema_version = 1
+    recorded_utc = [DateTime]::UtcNow.ToString('o')
+    scenario_declared = $Scenario
+    native_window_state_independently_observed = $false
