+#Requires -Version 5.1
+<#
+.SYNOPSIS
+Record benchmark context and call the existing Windows process collector.
+.DESCRIPTION
+An explicit invocation writes local measurement files. Application diagnostics
+remain opt-in through -IncludeDiagnostics. This wrapper does not create CPU
+load, change a power plan, minimize other windows, install anything, or use a
+network service. Scenario and build profile are declarations by the operator;
+they are not inferred from a filename or claimed as independently verified.
+.EXAMPLE
+.\benchmarks\run-windows.ps1 -Exe .\target\release\cpu-express.exe -Scenario visible -BuildProfile release -PowerSource AC -Seconds 300 -WarmupSeconds 30 -IncludeDiagnostics
+#>
+[CmdletBinding()]
+param(
+    [Parameter(Mandatory = $true)][string]$Exe,
+    [ValidateSet('visible', 'minimized', 'restore')][string]$Scenario = 'visible',
+    [Parameter(Mandatory = $true)][ValidateSet('release', 'debug', 'custom')][string]$BuildProfile,
+    [ValidateSet('AC', 'Battery', 'Unknown')][string]$PowerSource = 'Unknown',
+    [ValidateRange(5, 86400)][int]$Seconds = 300,
+    [ValidateRange(0, 86397)][int]$WarmupSeconds = 30,
+    [string]$SourceRevision = '',
+    [string]$CompilerVersion = '',
+    [string]$PowerModeNote = '',
+    [string]$DisplayNote = '',
+    [string]$Notes = '',
+    [string]$OutputDir,
+    [switch]$IncludeDiagnostics
+)
+
+Set-StrictMode -Version Latest
+$ErrorActionPreference = 'Stop'
+if ([Environment]::OSVersion.Platform -ne [PlatformID]::Win32NT) {
+    throw 'Run this collector on Windows; Linux results do not validate Windows.'
+}
+if ($WarmupSeconds -gt ($Seconds - 3)) {
+    throw 'Leave at least three seconds after WarmupSeconds.'
+}
+$resolvedExe = (Resolve-Path -LiteralPath $Exe).ProviderPath
+if (-not (Test-Path -LiteralPath $resolvedExe -PathType Leaf)) {
+    throw 'Exe must be a built CPU Express executable.'
+}
+$repositoryRoot = Split-Path -Parent $PSScriptRoot
+$collector = Join-Path $repositoryRoot 'scripts\measure-windows.ps1'
+if ([string]::IsNullOrWhiteSpace($OutputDir)) {
+    $OutputDir = Join-Path $repositoryRoot 'measurements'
+}
+$outputRoot = $ExecutionContext.SessionState.Path.GetUnresolvedProviderPathFromPSPath($OutputDir)
+$runName = 'context-{0}-{1}' -f (Get-Date -Format 'yyyyMMdd-HHmmss'), ([guid]::NewGuid().ToString('N').Substring(0, 8))
