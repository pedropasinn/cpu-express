+
+def process_row(end, duration, cumulative_cpu, interval_cpu, ram=1024):
+    return {
+        "elapsed_seconds": str(end),
+        "interval_seconds": str(duration),
+        "process_cpu_seconds": str(cumulative_cpu),
+        "interval_cpu_seconds": str(interval_cpu),
+        # Deliberately wrong rounded fields: analysis must use measured times.
+        "cpu_percent_one_core": "999",
+        "cpu_percent_machine": "999",
+        "working_set_bytes": str(ram),
+        "private_memory_bytes": str(ram * 2),
+        "post_warmup": "True",
+    }
+
+
+def frame_row(seconds, frames, hidden=False, event="sample"):
+    return {
+        "elapsed_seconds": seconds, "rendered_frames": frames,
+        "hidden": hidden, "event": event, "metric_status": "ready",
+        "cpu_percent": None, "ram_percent": None,
+        "used_memory_bytes": None, "total_memory_bytes": None,
+    }
+
+
+def make_run(directory, rows=None, diagnostics=None, complete=True):
+    if rows is None:
+        rows = [process_row(1, 1, 0.1, 0.1), process_row(2, 1, 0.2, 0.1)]
+    summary = {
+        "warmup_seconds": 0, "machine": {"logical_processors": 8},
+        "diagnostics_enabled": diagnostics is not None,
+        "exit_code": 0 if complete else 1, "forced_stop": not complete,
+        "error": None if complete else "interrupted", "metadata_warnings": [],
+        "actual_wall_seconds": 2.1, "requested_seconds": 2,
+    }
+    (directory / "summary.json").write_text(json.dumps(summary), encoding="utf-8-sig")
+    buffer = io.StringIO(newline="")
+    writer = csv.DictWriter(buffer, fieldnames=process_row(0, 0, 0, 0).keys())
+    writer.writeheader()
+    writer.writerows(rows)
+    (directory / "process-samples.csv").write_text(buffer.getvalue(), encoding="utf-8-sig")
+    if diagnostics is not None:
+        text = "\n".join(json.dumps(row) for row in diagnostics) + "\n"
+        (directory / "application.jsonl").write_text(text, encoding="utf-8")
+
+
+class ProcessAnalysisTests(unittest.TestCase):
+    def test_cpu_uses_time_deltas_and_weighted_duration(self):
+        result = analyze_process([
+            process_row(1, 1, 1, 1), process_row(4, 3, 1.3, 0.3, ram=2048),
+        ], 8, 0)
+        self.assertAlmostEqual(result["cpu_percent_one_logical_processor_weighted_mean"], 32.5)
+        self.assertAlmostEqual(result["cpu_percent_machine_weighted_mean"], 4.0625)
+        dist = result["cpu_percent_one_logical_processor"]
+        self.assertAlmostEqual(dist["p50"], 55)
+        self.assertAlmostEqual(dist["p95"], 95.5)
+        self.assertAlmostEqual(result["cpu_seconds_after_warmup"], 1.3)
+        self.assertEqual(result["observed_wall_seconds_after_warmup"], 4)
+        self.assertEqual(result["working_set_bytes"]["p50"], 1536)
+        self.assertFalse(result["lifetime_cpu_total_complete"])
+
+    def test_cpu_can_exceed_one_logical_processor(self):
+        result = analyze_process([process_row(1, 1, 2, 2)], 8, 0)
+        self.assertEqual(result["cpu_percent_one_logical_processor"]["p95"], 200)
+        self.assertEqual(result["cpu_percent_machine"]["p50"], 25)
+
+    def test_warmup_crossing_interval_is_excluded_without_prorating(self):
+        result = analyze_process([
+            process_row(1, 1, 1, 1), process_row(4, 3, 1.3, 0.3),
+        ], 8, 0.5)
